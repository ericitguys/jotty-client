{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jotty-desktop",
  "version": "0.13.0",
  "identifier": "page.jotty.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "jotty·desktop", "width": 1200, "height": 800 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage", "rpm"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": { "minSdkVersion": 26 } }
}
